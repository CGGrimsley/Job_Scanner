# Copy to .env and fill in what you need. Everything is optional; .env is gitignored.

# Where the app runs: http://127.0.0.1:<port>
JOB_SCANNER_PORT=8766

# Home server / Docker only. Anything other than 127.0.0.1 needs a password, asked once per browser.
# JOB_SCANNER_HOST=0.0.0.0
JOB_SCANNER_PASSWORD=
# Host names you'll type in the browser besides IP addresses (e.g. homelab.lan,jobs.example.com)
JOB_SCANNER_ALLOWED_HOSTS=
# Docker: the port published on the server (the container itself always listens on 8766)
# JOB_SCANNER_HOST_PORT=8766

# Docker: your time zone, so the morning brief arrives in your morning (e.g. America/New_York)
# TZ=America/New_York
# The address you open the app at, for the "In Job Scanner" button on phone alerts (also settable on Setup)
# JOB_SCANNER_PUBLIC_URL=https://jobs.example.com
# Your own ntfy server for phone alerts (default https://ntfy.sh)
# JOB_SCANNER_NTFY_SERVER=

# Where your profile, résumé and captured jobs are kept (default: ~/.job_scanner)
JOB_SCANNER_DATA=

# Claude runs through Claude Code on your Claude subscription. If you've signed in by running `claude` once,
# you don't need anything here. For a service or Docker, run `claude setup-token` and paste the token:
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: a specific model for Claude Code (blank = your Claude Code default)
JOB_SCANNER_CLI_MODEL=

# Optional fallback without a subscription: a pay-as-you-go API key (pip install anthropic).
# Only used when Claude Code isn't installed, or with JOB_SCANNER_AI=api.
ANTHROPIC_API_KEY=
# JOB_SCANNER_AI=auto   # auto | cli | api | off
# Optional: a USAJobs API key (developer.usajobs.gov) for Watching, instead of pasting it in the app.
# JOB_SCANNER_USAJOBS_KEY=
# JOB_SCANNER_USAJOBS_EMAIL=
