# Copy to .env and fill in what you need. Everything is optional; .env is gitignored.

# Where the app runs: http://127.0.0.1:<port>
JOB_SCANNER_PORT=8766

# Where your profile, résumé and captured jobs are kept (default: ~/.job_scanner)
JOB_SCANNER_DATA=

# Claude runs through Claude Code on your Claude subscription. If you've signed in by running `claude` once,
# you don't need anything here. For a service or Docker, run `claude setup-token` and paste the token:
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: a specific model for Claude Code (blank = your Claude Code default)
JOB_SCANNER_CLI_MODEL=

# Optional fallback without a subscription: a pay-as-you-go API key (pip install anthropic).
# Only used when Claude Code isn't installed, or with JOB_SCANNER_AI=api.
ANTHROPIC_API_KEY=
# JOB_SCANNER_AI=auto   # auto | cli | api | off
